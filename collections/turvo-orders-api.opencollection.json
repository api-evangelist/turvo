{
  "opencollection": "1.0.0",
  "info": {
    "name": "Turvo Public Accounts Orders API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://publicapi.turvo.com/v1/orders/list",
            "params": [
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Zero-based offset of the first record to return."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return per page."
              }
            ]
          },
          "docs": "Lists orders in the tenant, with pagination and filtering."
        },
        {
          "info": {
            "name": "Create an order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://publicapi.turvo.com/v1/orders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new order with line items and ship-from / ship-to detail."
        },
        {
          "info": {
            "name": "Retrieve an order",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://publicapi.turvo.com/v1/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The Turvo resource ID."
              }
            ]
          },
          "docs": "Retrieves a single order by its Turvo ID."
        },
        {
          "info": {
            "name": "Update an order",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://publicapi.turvo.com/v1/orders/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The Turvo resource ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing order."
        }
      ]
    }
  ],
  "bundled": true
}