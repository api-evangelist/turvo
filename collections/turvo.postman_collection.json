            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "x-api-key", "value": "{{apiKey}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Blue Line Trucking\",\n  \"mcNumber\": \"\",\n  \"dotNumber\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/carriers", "host": ["{{baseUrl}}"], "path": ["carriers"] },
