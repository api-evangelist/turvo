{
  "opencollection": "1.0.0",
  "info": {
    "name": "Turvo Public Accounts Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange credentials for an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://publicapi.turvo.com/v1/oauth/token",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchanges tenant API credentials for an OAuth 2.0 Bearer access token. Send the x-api-key header along with the grant. Turvo documents a password grant for tenant users; the returned access_token is then passed as Authorization: Bearer on subsequent calls."
        }
      ]
    }
  ],
  "bundled": true
}